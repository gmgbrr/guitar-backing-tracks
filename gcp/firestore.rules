rules_version = '2';
// Acesso direto ao Firestore (SDKs web/mobile do Firebase) é proibido.
// Só a API acessa o banco, com a conta de serviço backing-tracks-api (que não passa por estas regras).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
